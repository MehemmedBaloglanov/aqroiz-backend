  "item": [
    {
      "name": "00 Sistem",
      "item": [
        {
          "name": "Sağlamlıq yoxlaması",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));\npm.test('Tətbiq işləyir (UP)', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Gözlənilən: 200 OK, {\"status\":\"UP\"}"
          },
          "response": []
        },
        {
          "name": "Tokensiz sorğu",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));\r\npm.test('Kod UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ping"
              ]
            }
          },
          "response": []
        }
      ],
      "description": "Tətbiqin vəziyyəti. Giriş tələb etmir."
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "giris",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));\r\nconst body = pm.response.json();\r\npm.test('Token gəldi', () => pm.expect(body.accessToken).to.be.a('string'));\r\npm.test('Rol OWNER', () => pm.expect(body.user.role).to.eql('OWNER'));\r\n// Tokeni mühitə yazırıq: kolleksiyanın bütün sorğuları onu avtomatik istifadə edəcək\r\npm.environment.set('token', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"rehber@demo.aqroiz.az\",\r\n  \"password\": \"Demo-12345\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
